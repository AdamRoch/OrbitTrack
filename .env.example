# Required for a hosted deployment. Keep real values in local or Railway secrets.
ORBITTRACK_ADMIN_EMAIL=you@example.com
ORBITTRACK_AGENT_TOKEN=replace-with-a-long-random-agent-token
NEXTAUTH_SECRET=replace-with-a-long-random-session-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local tracker settings.
TRACKER_DB_PATH=data/tracker.db
TRACKER_PREFIX=LIN
TRACKER_SEED=true
